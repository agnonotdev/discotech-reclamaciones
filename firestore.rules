rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /admins/{adminId} {
      // Los usuarios autenticados pueden consultar administradores para la lista de asignación
      allow read: if request.auth != null;
      // Nadie escribe esta colección desde el cliente; se gestiona manualmente
      allow create, update, delete: if false;
    }

    match /reclamaciones/{ticketId} {
      allow create: if request.resource.data.keys().hasAll(['nombre', 'email', 'tipo', 'mensaje', 'estado', 'createdAt', 'radicado'])
                    && request.resource.data.nombre is string
                    && request.resource.data.email is string
                    && (request.resource.data.estado == 'Nuevo' || request.resource.data.estado == 'Pendiente');

      // Se valida contra la colección admins en vez de un correo fijo
      allow read, update, delete: if request.auth != null
                                   && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));

      match /timeline/{eventId} {
        // Solo administradores autorizados pueden leer y registrar eventos/notas
        allow read, create: if request.auth != null
                             && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
        // AUDITORÍA INMUTABLE: Ningún usuario ni administrador puede modificar o eliminar eventos registrados
        allow update, delete: if false;
      }
    }
  }
}