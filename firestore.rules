rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /admins/{adminId} {
      // Un usuario solo puede leer SU PROPIO documento de admin (para verificar si lo es)
      allow read: if request.auth != null && request.auth.token.email == resource.data.email;
      // Nadie escribe esta colección desde el cliente; se gestiona manualmente
      allow create, update, delete: if false;
    }

    match /reclamaciones/{ticketId} {
      allow create: if request.resource.data.keys().hasAll(['nombre', 'email', 'tipo', 'mensaje', 'estado', 'createdAt'])
                    && request.resource.data.nombre is string
                    && request.resource.data.email is string
                    && request.resource.data.estado == 'Pendiente';

      // Se valida contra la colección admins en vez de un correo fijo
      allow read, update: if request.auth != null
                           && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));

      allow delete: if false;
    }
  }
}